# Phoenix runtime
PHX_SERVER=true
PHX_HOST=example.com
PORT=4001
SECRET_KEY_BASE=replace_with_mix_phx_gen_secret
SHIMMIE_SECRET=replace_with_a_separate_mix_phx_gen_secret

# PostgreSQL (required in production)
DATABASE_URL=ecto://user:pass@127.0.0.1/shimmie_phx_prod

# Asset/media root and native private settings
SHIMMIE_LEGACY_ROOT=/path/to/shimmie2
SHIMMIE_CONFIG_PATH=/path/to/shimmie2/data/config/site.json

# Optional overrides
# SHIMMIE_DATABASE_URL=ecto://user:pass@127.0.0.1/shimmie
